# Optional local overrides. Copy to config/.env if needed.
# Loaded by ashare_data.config at config-load time (load_dotenv with
# override=False): pre-existing process environment variables win.
# ASHARE_DATA_DIR=data
# ASHARE_DUCKDB_PATH=data/ashare.duckdb
# ASHARE_PARQUET_DIR=data/parquet
# Force AkShareClient offline fixtures (truthy: 1/true/yes). Consumed via
# os.getenv AFTER config load (ashare_data/akshare_client.py); entry points
# that never load config do not see .env values.
# ASHARE_OFFLINE=1
